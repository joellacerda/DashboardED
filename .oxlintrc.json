{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-alert": "error",
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-console": ["warn", { "allow": ["error", "warn"] }]
  },
  "overrides": [
    {
      "files": ["src/contexts/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["**/*.test.js", "**/*.test.jsx"],
      "env": {
        "node": true
      },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "vi": "readonly"
      }
    }
  ]
}
