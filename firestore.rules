rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funções Auxiliares de Segurança e Conformidade LGPD
    // =========================================================================

    // Verifica se o usuário está autenticado no Firebase Authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifica se o e-mail do usuário foi verificado (quando aplicável)
    function isEmailVerified() {
      return isAuthenticated() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // =========================================================================
    // Coleção de Auditoria (auditLogs / audit_logs)
    // Conformidade LGPD: Append-Only imutável.
    // Qualquer usuário autenticado pode registrar ações e ler registros de auditoria,
    // mas NINGUÉM pode alterar ou deletar logs existentes na nuvem.
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Imutabilidade estrita
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Imutabilidade estrita
    }

    // =========================================================================
    // Coleções Principais do Sistema (MODULES - src/utils/storage/core.js)
    // Acesso permitido a usuários devidamente autenticados
    // =========================================================================

    // Pacientes e Exames
    match /exames/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Fluxo de Caixa Consolidado
    match /fluxoCaixa/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Detalhes dos Exames e Repasses
    match /detalhesExames/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Folha de Pagamento
    match /folhaPagamento/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Corpo Clínico (Médicos e Honorários)
    match /medicos/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Ajustes e Histórico de Repasses
    match /repassesAjustes/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Exames por Convênio e Tabelas de Procedimentos
    match /examesConvenio/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Cronograma e Escalas de Salas
    match /cronogramaSalas/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Configuração de Salas e Recursos Físicos
    match /salasConfig/{docId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // Coleções Legadas (Compatibilidade Regressiva)
    // Mantidas para suporte a versões anteriores do esquema
    // =========================================================================

    // Detalhes Financeiros dos Exames (legado)
    match /detalhes/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Convênios e Fluxos de Recebimento (legado)
    match /convenios/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Folha de Pagamento (legado)
    match /folha/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Cronograma de Exames e Escalas (legado)
    match /cronograma/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Consultas Clínicas (legado)
    match /consultas/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Categorias Financeiras (legado)
    match /categorias/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Metadados do Sistema e Versão do Esquema (legado)
    match /metadata/{docId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // Regra Padrão: Bloqueia qualquer acesso a coleções não declaradas
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
